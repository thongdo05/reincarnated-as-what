; Engine configuration file.
; Reincarnated as WHAT?! — landscape side-scrolling prototype for Godot 4.7.

config_version=5

[application]

config/name="Reincarnated as WHAT?!"
config/description="A landscape side-scrolling reincarnation shooter. One life. Drag to move. Auto-fire."
config/version="0.1.0"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
boot_splash/bg_color=Color(0.0627451, 0.0470588, 0.0784314, 1)
boot_splash/show_image=false
config/icon="res://app_icon/app_icon_1024.png"

[autoload]

Monetization="*res://scripts/monetization.gd"

[display]

window/size/viewport_width=480
window/size/viewport_height=270
window/size/window_width_override=960
window/size/window_height_override=540
window/stretch/mode="viewport"
window/stretch/aspect="keep"
window/stretch/scale_mode="integer"
window/handheld/orientation=4
window/vsync/vsync_mode=1

[input]

use_accumulated_input=false

[input_devices]

pointing/emulate_mouse_from_touch=true
buffering/agile_event_flushing=true

[audio]

buses/default_bus_layout="res://audio/default_bus_layout.tres"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/canvas_textures/default_texture_filter=0
environment/defaults/default_clear_color=Color(0.0627451, 0.0470588, 0.0784314, 1)
2d/snap/snap_2d_transforms_to_pixel=true
2d/snap/snap_2d_vertices_to_pixel=true

[admob]

general/android/enabled=true
general/android/app_id="ca-app-pub-3940256099942544~3347511713"
general/android/enable_r8_optimization=false
general/android/disable_initialization_optimization=false
general/android/disable_ad_loading_optimization=false
general/ios/enabled=true
general/ios/app_id="ca-app-pub-3940256099942544~1458002511"
mediation/applovin=false
mediation/bidmachine=false
mediation/chartboost=false
mediation/dtexchange=false
mediation/imobile=false
mediation/inmobi=false
mediation/ironsource=false
mediation/line=false
mediation/maio=false
mediation/meta=false
mediation/mintegral=false
mediation/moloco=false
mediation/mytarget=false
mediation/pangle=false
mediation/pubmatic=false
mediation/unity_ads=false
mediation/vungle=false

[editor_plugins]

enabled=PackedStringArray("res://addons/raw_store/plugin.cfg", "res://addons/admob/plugin.cfg", "res://addons/GodotGooglePlayBilling/plugin.cfg")
